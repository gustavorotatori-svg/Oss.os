rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity validation: Review
    function isValidReview(data) {
      return data.userName is string && data.userName.size() >= 2 && data.userName.size() <= 100 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() >= 5 && data.comment.size() <= 3000 &&
             data.date is string && data.date.size() > 0 &&
             data.userId == request.auth.uid &&
             (data.get('userAvatar', null) == null || (data.userAvatar is string && data.userAvatar.size() <= 512));
    }

    // Entity validation: Offer
    function isValidOffer(data) {
      return data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.url is string && data.url.size() > 0 && data.url.size() <= 1024 &&
             data.isAvailable is bool &&
             (data.get('shippingPrice', null) == null || (data.shippingPrice is number && data.shippingPrice >= 0)) &&
             (data.get('shippingInfo', null) == null || (data.shippingInfo is string && data.shippingInfo.size() <= 128)) &&
             (data.get('previousPrice', null) == null || (data.previousPrice is number && data.previousPrice >= 0)) &&
             (data.get('updatedAt', null) == null || data.updatedAt is string || data.updatedAt is timestamp);
    }

    // Entity validation: Comment
    function isValidComment(data) {
      return data.userName is string && data.userName.size() >= 2 && data.userName.size() <= 100 &&
             data.commentText is string && data.commentText.size() >= 2 && data.commentText.size() <= 4000 &&
             data.createdAt is timestamp &&
             data.userId == request.auth.uid &&
             (data.get('userAvatar', null) == null || (data.userAvatar is string && data.userAvatar.size() <= 512)) &&
             (data.get('stoicTag', null) == null || (data.stoicTag is string && data.stoicTag.size() <= 64));
    }

    // Entity validation: Academy
    function isValidAcademy(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 150 &&
             data.professor is string && data.professor.size() >= 2 && data.professor.size() <= 150 &&
             data.location is string && data.location.size() >= 2 && data.location.size() <= 150 &&
             (data.get('verified', null) == null || data.verified is bool);
    }

    // Entity validation: Product
    function isValidProduct(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 150 &&
             data.price is number && data.price >= 0 &&
             data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 1024 &&
             data.affiliateUrl is string && data.affiliateUrl.size() > 0 && data.affiliateUrl.size() <= 1024 &&
             data.platform is string && data.platform.size() >= 2 && data.platform.size() <= 50 &&
             data.category is string && data.category.size() >= 2 && data.category.size() <= 50;
    }

    // Entity validation: UserProfile
    function isValidUserProfile(data) {
      return data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 100 &&
             data.points is number && data.points >= 0 &&
             (data.get('email', null) == null || (data.email is string && data.email.size() <= 150)) &&
             (data.get('beltColor', null) == null || (data.beltColor is string && data.beltColor.size() <= 50)) &&
             (data.get('streak', null) == null || (data.streak is number && data.streak >= 0)) &&
             (data.get('academyId', null) == null || (data.academyId is string && data.academyId.size() <= 128)) &&
             (data.get('lgpdConsent', null) == null || data.lgpdConsent is map);
    }

    // Entity validation: WishlistItem
    function isValidWishlistItem(data) {
      return (data.get('alertEnabled', null) == null || data.alertEnabled is bool) &&
             (data.get('addedAt', null) == null || data.addedAt is string || data.addedAt is timestamp) &&
             (data.get('targetPrice', null) == null || data.targetPrice is number) &&
             (data.get('lastNotifiedPrice', null) == null || data.lastNotifiedPrice is number) &&
             (data.get('notificationType', null) == null || data.notificationType is string) &&
             (data.get('notificationEmail', null) == null || data.notificationEmail is string) &&
             (data.get('lastNotifiedAt', null) == null || data.lastNotifiedAt is string || data.lastNotifiedAt is timestamp);
    }

    // --- RULES ---

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Collection Group Query for Reviews (Public Read Access)
    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
    }

    // Collection Group Query for Offers (Public Read Access)
    match /{path=**}/offers/{offerId} {
      allow read: if true;
    }

    // Products and sub-collections (Public Read Access for products and reviews)
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(productId) && isValidProduct(incoming()) &&
                            incoming().keys().hasAll(['title', 'price', 'imageUrl', 'affiliateUrl', 'platform', 'category']) &&
                            incoming().keys().size() >= 6 && incoming().keys().size() <= 20;
      allow delete: if isSignedIn();
      
      match /reviews/{reviewId} {
        // Public read access for reviews
        allow read: if true;
        
        // Authenticated users can post reviews
        allow create: if isSignedIn() && isValidId(productId) && isValidId(reviewId) &&
                      isValidReview(incoming()) &&
                      incoming().keys().hasAll(['userName', 'rating', 'comment', 'date', 'userId']) &&
                      incoming().keys().size() >= 5 && incoming().keys().size() <= 7;
        
        // Owners can update their reviews
        allow update: if isSignedIn() && isOwner(existing().userId) && 
                      isValidReview(incoming()) &&
                      incoming().userId == existing().userId &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['userName', 'rating', 'comment', 'date', 'userAvatar', 'createdAt']);
        
        // Owners can delete their reviews
        allow delete: if isSignedIn() && isOwner(existing().userId);
      }

      match /offers/{offerId} {
        allow read: if true;
        
        allow create, update: if isValidId(productId) && isValidId(offerId) &&
                              isValidOffer(incoming()) &&
                              incoming().keys().hasAll(['storeName', 'price', 'url', 'isAvailable']) &&
                              incoming().keys().size() >= 4 && incoming().keys().size() <= 8;
        
        allow delete: if isSignedIn();
      }
    }

    // Blog Post Comments (Public Read Access)
    match /blog_posts/{postId}/comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(postId) && isValidId(commentId) &&
                    isValidComment(incoming()) &&
                    incoming().keys().hasAll(['userName', 'commentText', 'createdAt', 'userId']) &&
                    incoming().keys().size() >= 4 && incoming().keys().size() <= 6;
      allow update: if isSignedIn() && isOwner(existing().userId) &&
                    isValidComment(incoming()) &&
                    incoming().userId == existing().userId &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['commentText', 'stoicTag']);
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    // Users Collection (Protected - Read & Write restricted strictly to document owner)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Public/Secured Collections
    match /test/{testId} {
      allow read: if true;
    }

    match /subscribers/{subId} {
      allow create: if true;
    }

    match /academies/{academyId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(academyId) && isValidAcademy(incoming()) &&
                            incoming().keys().hasAll(['name', 'professor', 'location']) &&
                            incoming().keys().size() >= 3 && incoming().keys().size() <= 4;
    }
  }
}
